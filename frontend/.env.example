# LabSetu Backend API Configuration
# Point this to your backend server (e.g. Node/Express, Django, FastAPI, Spring Boot, etc.)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to "false" to use real backend API calls.
# Set to "true" to force mock/localStorage mode.
# Note: If the backend server is unreachable, apiClient will gracefully fallback to local demo data.
VITE_USE_MOCK=false

# Enable debug console logs for outgoing requests and responses
VITE_ENABLE_API_LOGS=true
